{
  "manifest_version": 3,
  "name": "One Tap Code Block",
  "version": "0.1.0",
  "description": "Press Right Alt in supported text fields to insert or wrap a Markdown fenced code block.",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
